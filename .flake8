# Lint-Regeln des Projekts.
#
# **Warum es diese Datei gibt.** Die Regeln standen nur in CLAUDE.md und in einer
# Zeile von `.github/workflows/tests.yml`. Ein Editor, der eine Datei aufmacht,
# hat davon nichts: er kennt weder die gewuenschte Zeilenlaenge noch weiss er,
# welche Regeln hier erzwungen werden. Beides steht jetzt da, wo Werkzeuge es
# finden — `python -m flake8` ohne Argumente macht damit genau das, was auch die
# CI macht.

[flake8]
# Was ERZWUNGEN wird. Dieselbe Auswahl wie im CI-Job `lint`; wer sie hier
# aendert, aendert sie dort mit.
#
# - F (= pyflakes): tote Importe, Tippfehler in Namen, doppelte Definitionen —
#   alles, was ein echter Fehler ist und keine Geschmacksfrage.
# - C90 (Komplexitaet ueber `max-complexity`): seit Oktober 2026. Hier standen
#   einmal 108 Funktionen darueber, 44 davon in den Konsolen-Editoren; sie sind
#   Stufe fuer Stufe zerlegt worden, jede erst festgehalten und danach
#   gegengeprueft. Die Zahl ist in `autoclicker/`, `main.py` und `tools/` auf
#   null — eine neue Funktion darueber ist damit ein Rueckschritt, kein Bestand.
#   Ausgenommen sind `market_analysis/` (ein eigenes Teilprojekt, das hier
#   niemand anfasst) und `tests/` (Pruefungen stehen dort als Modulcode, und
#   mccabe zaehlt einen ganzen Pruefblock als eine Funktion).
select = F, C90
per-file-ignores =
    market_analysis/*: C901
    tests/*: C901
max-complexity = 11

# Was ANGESTREBT wird, aber (noch) nicht erzwungen ist: die Zeilenlaenge.
# Gemessen, nicht geraten — in `autoclicker/`, `main.py` und `tools/` liegen
# noch 214 Zeilen ueber 100 Spalten. Ein Lauf, der beim Aufmachen 200 Treffer
# meldet, wird nicht gelesen, und ein rotes CI, das nur Altlasten beschreibt,
# verdeckt echte Fehler im Rauschen — dieselbe Regel wie beim Ueberspringen
# fehlender Testpakete. Der Editor liest den Wert trotzdem und zieht seine
# Hilfslinie an der richtigen Stelle; nachsehen kann man jederzeit:
#
#     python -m flake8 --select=E501 autoclicker/ main.py tools/
#
# Sinkt die Zahl auf null, gehoert die Regel in `select`.
max-line-length = 100

exclude =
    .git,
    .venv,
    __pycache__,
    build,
    dist
