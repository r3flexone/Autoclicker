# OS
.DS_Store
Thumbs.db

# User config (auto-generated with defaults)
config.json

# Laufstatus des Workers (runtime/status.py) - existiert nur waehrend eine
# Sequenz laeuft. Liegt hier oben und nicht in sequences/, weil ein
# *.json-Glob ueber den Ordner sie sonst als Sequenz auflisten wuerde.
.run.json
.recording.json
.studio-sequence.json
.reclick.json

# Briefkasten fuer Befehle aus dem Sequenz-Studio (mailbox.py) - existiert nur
# Sekundenbruchteile, wird beim Lesen geleert. Aus denselben Gruenden hier oben
# wie .run.json.
.command.json

# Aktueller Bestand: vollständige Sequenzordner und wiederverwendbare Presets.
sequences/
presets/

# Alte, typweise getrennte Bestände bleiben ignoriert, damit vorhandene
# Nutzerdateien niemals versehentlich in Git landen. Neu geschrieben werden sie
# nicht mehr; sie können nach manueller Kontrolle archiviert oder gelöscht werden.
slots/
items/
item_scans/
boss_scans/
icon_scans/
exports/
# Sicherungen des Start-Durchgangs (persistence/sweep.py) - spiegelt die Ordner darueber
backups/
# Lauf-Screenshots (SEQUENCE_SCREENSHOTS_DIR). Die alte Schreibweise bleibt
# ignoriert, damit ein liegengebliebener Altbestand nie in Git landet — auf Linux ist
# das Muster gross/klein-empfindlich.
Screenshots/
slots/Screenshots/
screenshots/

# Logs
logs/
*.log

# Debug-Bilder des Slot-Testers (tools/slot_tester.py legt den Ordner selbst an)
tools/debug/

# Markt-Analyse - generierte Ausgaben
market_analysis/output/

# Item-/Gegner-Katalog aus der Spiel-API (tools/catalog.py) — generierte Daten,
# dieselbe Ueberlegung wie beim Programm-Symbol: eine Kopie im Repo veraltet
# still, sobald das Spiel Items nachlegt. Neu holen kostet ein Kommando.
katalog.json

# Das Programm-Symbol wird erzeugt, nicht eingecheckt (tools/symbol.py) —
# eine Binaerdatei im Repo waere eine Kopie des Motivs, die niemand mitzieht.
symbol/
