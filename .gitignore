# Laufstatus des Workers (runtime/status.py) - existiert nur waehrend eine
# Sequenz laeuft. Liegt hier oben und nicht in sequences/, weil ein
# *.json-Glob ueber den Ordner sie sonst als Sequenz auflisten wuerde.
.lauf.json

# User data folders (auto-generated)
# Reihenfolge wie das Persistenz-Layout in CLAUDE.md — wer dort einen Ordner ergaenzt,
# ergaenzt ihn hier. Sonst landen fremde Boss-Profile und Session-Logs im naechsten PR.
sequences/
slots/
items/
item_scans/
boss_scans/
icon_scans/
exports/
# Sicherungen des Start-Durchgangs (persistence/sweep.py) - spiegelt die Ordner darueber
backups/
# Screenshots gibt es zweimal: SCREENSHOTS_DIR (slots/Screenshots) und
# SEQUENCE_SCREENSHOTS_DIR (screenshots, klein). Beide ausschreiben — auf Linux ist
# das Muster gross/klein-empfindlich, ein einzelnes `Screenshots/` deckt dort nur eins ab.
Screenshots/
slots/Screenshots/
screenshots/

# Logs
logs/
*.log

# Markt-Analyse - generierte Ausgaben
market_analysis/output/
